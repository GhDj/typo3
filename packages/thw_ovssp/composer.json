{
    "name": "thw/thw-ovssp",
    "type": "typo3-cms-extension",
    "description": "THW OV Self-Service-Portal (OV-SSP)",
    "license": "GPL-2.0-or-later",
    "require": {
        "typo3/cms-core": "^14.0",
        "typo3/cms-extbase": "^14.0",
        "typo3/cms-frontend": "^14.0"
    },
    "autoload": {
        "psr-4": {
            "Init\\Thw\\Ovssp\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Init\\Thw\\Ovssp\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "thw_ovssp"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-fluid": "^14.3"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    }
}
